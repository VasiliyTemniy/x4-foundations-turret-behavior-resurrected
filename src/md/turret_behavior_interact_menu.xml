<?xml version="1.0" encoding="utf-8" ?>
<mdscript name="VAS_TurretBehavior_Interact" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <!--
    Right-click interact-menu entries for Turret Behavior Menu: copy turret
    behaviour from the right-clicked ship to the other selected ships, either by
    turret type or by slot position. The copy itself is done by the companion
    Lua (ui/turret_behavior.lua); config state lives in turret_behavior.xml
    (VAS_TurretBehavior.ModConfig), options UI in turret_behavior_config_menu.xml.
  -->
  <cues>
    <cue name="Add_Interact_Actions" instantiate="true">
      <conditions>
        <event_cue_signalled cue="md.Interact_Menu_API.Get_Actions"/>
      </conditions>
      <actions>
        <set_value name="$target" exact="@event.param.$object"/>
        <set_value name="$ships" exact="@event.param.$selectedplayerships"/>
        <do_if value="@$target.isclass.ship and @$target.isplayerowned">
          <do_if value="@$ships.{1} != null">
            <signal_cue_instantly cue="md.Interact_Menu_API.Add_Action" param="table[
              $id       = 'vas_tb_copy_by_type',
              $section  = 'selected_orders',
              $text     = {202600531,10},
              $callback = CopyByType,
            ]"/>
            <signal_cue_instantly cue="md.Interact_Menu_API.Add_Action" param="table[
              $id       = 'vas_tb_copy_by_slot',
              $section  = 'selected_orders',
              $text     = {202600531,11},
              $callback = CopyBySlot,
            ]"/>
          </do_if>
        </do_if>
        <cancel_cue cue="this"/>
      </actions>
    </cue>

    <cue name="CopyByType">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="player.entity.$vas_tb_copy" exact="table[
          $ships = @event.param.$selectedplayerships,
        ]"/>
        <raise_lua_event name="'VAS_TB.CopyByType'" param="@event.param.$object"/>
        <reset_cue cue="this"/>
      </actions>
    </cue>

    <cue name="CopyBySlot">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="player.entity.$vas_tb_copy" exact="table[
          $ships = @event.param.$selectedplayerships,
        ]"/>
        <raise_lua_event name="'VAS_TB.CopyBySlot'" param="@event.param.$object"/>
        <reset_cue cue="this"/>
      </actions>
    </cue>
  </cues>
</mdscript>
