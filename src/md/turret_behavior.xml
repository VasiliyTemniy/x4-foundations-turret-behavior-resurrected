<?xml version="1.0" encoding="utf-8" ?>
<mdscript name="VAS_TurretBehavior" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <!--
    Loads the companion Lua and registers two right-click actions on selected_orders
    via SirNukes Interact_Menu_API: copy turret behaviour from the right-clicked
    ship to the other selected ships, either by turret type or by slot position.
  -->
  <cues>
    <!-- Config STATE container. Defaults live in exactly one place: SeedDefaults
         below (it supersedes the old version-2 patch block). The Extension
         Options UI is in turret_behavior_config_menu.xml and reads/writes this
         cue cross-script. -->
    <cue name="ModConfig" namespace="this" version="2">
      <actions>
        <run_actions ref="SeedDefaults"/>
      </actions>
    </cue>

    <!--@doc
        Idempotent defaults seeder. Plain cues run their actions once per
        playthrough, so vars added in a mod UPDATE never appear in old saves
        unless seeded here on load. String-coercion null checks: explicit
        false/0 must NOT be re-seeded. -->
    <library name="SeedDefaults" purpose="run_actions">
      <actions>
        <set_value name="$defaults" exact="table[
          $debugEnabled = false,
          $showSelectedShipsMenu = true,
          $showStationMenu = true,
          $showPlayerShipMenu = false,
        ]"/>
        <do_for_each name="$key" in="$defaults.keys.list">
          <do_if value="(@md.VAS_TurretBehavior.ModConfig.{$key} + '') == 'null'">
            <set_value name="md.VAS_TurretBehavior.ModConfig.{$key}" exact="$defaults.{$key}"/>
          </do_if>
        </do_for_each>
      </actions>
    </library>

    <!-- Heal old saves on every load and re-push the Lua blackboard mirrors.
         Root's once-per-playthrough actions can't be trusted with anything
         added after release. -->
    <!-- event_universe_generated fires both at new-game start AND on every
         savegame load (md.xsd), so it alone covers all sessions - adding
         event_game_loaded would double-fire this cue on loads. -->
    <cue name="InitDefaults" instantiate="true">
      <conditions>
        <event_universe_generated/>
      </conditions>
      <actions>
        <run_actions ref="SeedDefaults"/>
        <set_value name="player.entity.$vas_tb_debug_chance" exact="if md.VAS_TurretBehavior.ModConfig.$debugEnabled then 100 else 0"/>
        <set_value name="player.entity.$vas_tb_show_selected_ships_menu" exact="md.VAS_TurretBehavior.ModConfig.$showSelectedShipsMenu"/>
        <set_value name="player.entity.$vas_tb_show_station_menu" exact="md.VAS_TurretBehavior.ModConfig.$showStationMenu"/>
        <set_value name="player.entity.$vas_tb_show_player_ship_menu" exact="md.VAS_TurretBehavior.ModConfig.$showPlayerShipMenu"/>
      </actions>
    </cue>

    <!-- The right-click entries live in turret_behavior_interact_menu.xml
         (VAS_TurretBehavior_Interact); the old Root's mirror pushes are
         superseded by InitDefaults above, which re-runs every load. -->
  </cues>
</mdscript>
